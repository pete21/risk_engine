  <bpmn:process id="bpm_diagram_03f" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_1gtwqe4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1gtwqe4" sourceRef="StartEvent_1" targetRef="Calculate_PD" />
    <bpmn:serviceTask id="Calculate_PD" name="Calculate PD" camunda:type="external" camunda:topic="riskengine">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="model_name">logistic_regression</camunda:inputParameter>
          <camunda:inputParameter name="result" />
          <camunda:outputParameter name="pd">${result}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1gtwqe4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0nrb306</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_0nrb306" sourceRef="Calculate_PD" targetRef="check_pd" />
    <bpmn:endEvent id="EndEvent_0ajna93">
      <bpmn:incoming>SequenceFlow_1alo9xf</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="check_pd" name="Check if PD is below threshold 0.3">
      <bpmn:incoming>SequenceFlow_0nrb306</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1s2dp01</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">#{pd  &lt;= 0.3}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1s2dp01" sourceRef="check_pd" targetRef="Calculate_credit_price" />
    <bpmn:serviceTask id="Calculate_credit_price" name="Calculate credit price" camunda:type="external" camunda:topic="riskengine">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="model_name">risk_based_pricing</camunda:inputParameter>
          <camunda:inputParameter name="result" />
          <camunda:outputParameter name="final_result">${result}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1s2dp01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_008xt4t</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_008xt4t" sourceRef="Calculate_credit_price" targetRef="Finalize" />
    <bpmn:sequenceFlow id="SequenceFlow_1alo9xf" sourceRef="Finalize" targetRef="EndEvent_0ajna93" />
    <bpmn:serviceTask id="Finalize" name="Finalize" camunda:type="external" camunda:topic="${execution.getProcessInstanceId()}">
      <bpmn:incoming>SequenceFlow_008xt4t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1alo9xf</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
